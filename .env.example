# Configuración de Google API
# Obtén estos valores de Google Cloud Console: https://console.cloud.google.com/

# OAuth 2.0 Client ID
# Crear en: APIs & Services > Credentials > Create Credentials > OAuth client ID
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# API Key
# Crear en: APIs & Services > Credentials > Create Credentials > API Key
VITE_GOOGLE_API_KEY=AIzaSy-tu-api-key-aqui

# INSTRUCCIONES:
# 1. Copiar este archivo a .env.local
# 2. Reemplazar los valores con tus credenciales reales
# 3. NUNCA commitear el archivo .env.local
